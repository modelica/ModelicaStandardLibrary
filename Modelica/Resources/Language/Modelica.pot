msgid "Connector of a clock as input signal"
msgstr ""

msgctxt "Modelica.Clocked.ClockSignals.Sampler.SuperSample"
msgid "Connector of a clock as output signal (clock y is faster as clock of u)"
msgstr ""

msgctxt "Modelica.Clocked.ClockSignals.Sampler.SuperSample"
msgid "Super-sample the input clock and provide it as output clock"

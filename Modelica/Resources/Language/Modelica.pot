"</td><td valign=\"bottom\">\n"
"         Initial version implemented by\n"
"         A. Kl&ouml;ckner, F. v.d. Linden, D. Zimmer, M. Otter.<br>\n"
"         <a href=\"http://www.dlr.de/rmc/sr/en\">DLR Institute of System Dynamics and Control</a>\n"
"</td></tr></table>\n"
"</td></tr>\n"
"\n"
"</table>\n"
"</html>"
msgstr ""


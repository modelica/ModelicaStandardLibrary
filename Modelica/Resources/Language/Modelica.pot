"\n"
"<table border=\"1\" cellspacing=\"0\" cellpadding=\"2\">\n"
"<tr><td><strong><em>gravityType</em></strong></td>\n"
"    <td><strong><em>gravity [m/s2]</em></strong></td>\n"
"    <td><strong><em>description</em></strong></td></tr>\n"
"<tr><td>Types.GravityType.NoGravity</td>\n"
"    <td>= {0,0,0}</td>\n"
"    <td>No gravity</td></tr>\n"

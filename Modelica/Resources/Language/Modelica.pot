msgctxt "Modelica.Blocks.Math.Division"
msgid "<html>\n"
"<p>\n"
"This block computes the output <strong>y</strong>\n"
"by <em>dividing</em> the two inputs <strong>u1</strong> and <strong>u2</strong>:\n"
"</p>\n"
"<blockquote><pre>\n"
"y = u1 / u2;\n"
"</pre></blockquote>\n"
"\n"
"</html>"
msgstr ""


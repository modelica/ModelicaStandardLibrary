"</table>\n"
"\n"
"<blockquote><pre>\n"
"  *  = do not care\n"
"  U  = L.'U'\n"
"  0  = L.'0' or L.'L'\n"
"  1  = L.'1' or L.'H'\n"
"  X  = L.'X' or L.'W' or L.'Z' or L.'-'\n"
"  NC = no change\n"
"\n"

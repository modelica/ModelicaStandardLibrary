msgctxt "Modelica.Mechanics.Translational.Examples.Utilities.GenerateStribeckFrictionTable"
msgid "<html>\n"
"<p>\n"
"Returns a table with the friction characteristic\n"
"table[nTable,&nbsp;2]&nbsp;=&nbsp;[0,&nbsp;f1;&nbsp;&hellip;;&nbsp;v_max,&nbsp;fn],\n"
"where the first column is the velocity&nbsp;v in the range 0&nbsp;&hellip;&nbsp;v_max\n"
"and the second column is the friction force according to the Stribeck curve:\n"
"</p>\n"
"\n"
"<blockquote><pre>\n"
"f = F_Coulomb + F_prop*v + F_Stribeck*exp(-fexp*v);\n"
"</pre></blockquote>\n"
"</html>"
msgstr ""


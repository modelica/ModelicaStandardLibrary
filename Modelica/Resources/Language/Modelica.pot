"<dt>Walter Gander:</dt>\n"
"<dd> <strong>Adaptive Quadrature - Revisited</strong>. 1998.\n"
"     <a href=\"ftp://ftp.inf.ethz.ch/pub/publications/tech-reports/3xx/306.ps\">ftp://ftp.inf.ethz.ch/pub/publications/tech-reports/3xx/306.ps</a>\n"
"     </dd>\n"
"</dl>\n"
"</blockquote>\n"
"\n"
"<h4>Example</h4>\n"
"\n"

msgctxt "Modelica.Mechanics.MultiBody.Frames.axis"
msgid "<html>\n"
"<h4>Syntax</h4>\n"
"<blockquote><pre>\n"
"e = Frames.<strong>axis</strong>(axis);\n"
"</pre></blockquote>\n"
"\n"
"<h4>Description</h4>\n"
"<p>\n"
"A unit vector&nbsp;e is returned depending on whether x-, y-, or z-axis is required.\n"
"</p>\n"
"<blockquote><pre>\n"
" axis  |    e\n"
"-------+-----------\n"
"  1    |  {1,0,0}\n"
"  2    |  {1,0,0}\n"
"  3    |  {1,0,0}\n"
"</pre></blockquote>\n"
"</html>"
msgstr ""


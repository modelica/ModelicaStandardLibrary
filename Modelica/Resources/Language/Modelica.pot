"<blockquote><pre>\n"
"y = <strong>cos</strong>( u );\n"
"</pre></blockquote>\n"
"\n"
"<p>\n"
"<img src=\"modelica://Modelica/Resources/Images/Math/cos.png\"\n"
"     alt=\"cos.png\">\n"
"</p>\n"
"\n"
"</html>"
msgstr ""


"<p>The EnthalpyFlowSensor measures the enthalpy flow rate.</p>\n"
"<p>Thermodynamic equations are defined by Interfaces.FlowSensor.</p>\n"
"</html>"
msgstr ""

msgctxt "Modelica.Thermal.FluidHeatFlow.Sensors.EnthalpyFlowSensor"

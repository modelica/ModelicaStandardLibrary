msgstr ""

msgctxt "Modelica.Mechanics.MultiBody.Frames.TransformationMatrices.to_T_inv"
msgid "Return inverse transformation matrix T_inv from orientation object R"
msgstr ""

msgctxt "Modelica.Mechanics.MultiBody.Frames.TransformationMatrices.to_exy"

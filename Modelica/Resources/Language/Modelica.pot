"    by <a href=\"mailto:francesco.casella@polimi.it\">Francesco Casella</a>:<br>\n"
"       Created.</li>\n"
"</ul>\n"
"</html>"
msgstr ""

msgctxt "Modelica.Fluid.Utilities.regRoot"
msgid "Anti-symmetric square root approximation with finite derivative in the origin"

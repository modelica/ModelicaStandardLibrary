msgctxt "Modelica.Blocks.Math.RealToBoolean"
msgid "<html>\n"
"<p>\n"
"This block computes the Boolean output <strong>y</strong>\n"
"from the Real input <strong>u</strong> by the equation:\n"
"</p>\n"
"\n"
"<blockquote><pre>\n"
"y = u &ge; threshold;\n"
"</pre></blockquote>\n"
"\n"
"<p>\n"
"where <strong>threshold</strong> is a parameter.\n"
"</p>\n"
"</html>"
msgstr ""


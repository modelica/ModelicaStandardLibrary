msgctxt "Modelica.Blocks.Math.Gain"
msgid "<html>\n"
"<p>\n"
"This block computes output <em>y</em> as\n"
"<em>product</em> of gain <em>k</em> with the\n"
"input <em>u</em>:\n"
"</p>\n"
"<blockquote><pre>\n"
"y = k * u;\n"
"</pre></blockquote>\n"
"\n"
"</html>"

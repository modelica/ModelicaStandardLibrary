"All <strong>line force</strong> elements should be based on this base model.\n"
"This model defines frame_a and frame_b and computes the (guarded) relative\n"
"distance <strong>s</strong>. An assertion is raised if the relative\n"
"distance <strong>length</strong> became smaller as parameter <strong>s_small</strong>.\n"
"</p>\n"
"</html>"
msgstr ""

msgctxt "Modelica.Mechanics.MultiBody.Interfaces.LineForceBase"
msgid "= true, if rotation frame_a.R is fixed (to directly connect line forces)"
msgstr ""

msgctxt "Modelica.Mechanics.MultiBody.Interfaces.LineForceBase"

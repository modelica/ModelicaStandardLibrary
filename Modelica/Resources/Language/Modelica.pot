"<blockquote><pre>\n"
"y = <strong>exp</strong>(uInternal);\n"
"</pre></blockquote>\n"
"\n"
"<p>\n"
"<img src=\"modelica://Modelica/Resources/Images/Math/exp.png\"\n"
"     alt=\"exp.png\">\n"
"</p>\n"
"\n"
"</html>"
msgstr ""

msgctxt "Modelica.ComplexBlocks.ComplexMath.Exp"

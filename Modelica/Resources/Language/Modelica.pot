"<tr><td>Types.GravityType.PointGravity</td>\n"
"    <td>= -(mu/(r*r))*r/|r|</td>\n"
"    <td> Point gravity field with spherical mass</td></tr>\n"
"</table>\n"
"\n"
"</html>"

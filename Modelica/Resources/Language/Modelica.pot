msgctxt "Modelica.Mechanics.MultiBody.Frames.absoluteRotation"
msgid "<html>\n"
"<h4>Syntax</h4>\n"
"<blockquote><pre>\n"
"R2 = Frames.<strong>absoluteRotation</strong>(R1,R_rel);\n"

msgstr ""

msgctxt "Modelica.Clocked.RealSignals.Sampler.SuperSample"
msgid "Connector of clocked, Real output signal (clock of y is faster as clock of u)"
msgstr ""

msgctxt "Modelica.Clocked.RealSignals.Sampler.SuperSample"
msgid "Super-sample the clocked Real input signal and provide it as clocked output signal"
msgstr ""

msgctxt "Modelica.Clocked.RealSignals.Sampler.SuperSample"

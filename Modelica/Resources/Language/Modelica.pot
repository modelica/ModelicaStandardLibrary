"<a href=\"modelica://Modelica.Math.Matrices.eigenValues\">Matrices.eigenValues</a>,\n"
"<a href=\"modelica://Modelica.Math.Matrices.hessenberg\">Matrices.hessenberg</a>\n"
"</p>\n"
"</html>"

"  <tr><td>*</td> <td>X</td> <td>1</td>  <td>1</td> <td>X or U or NC</td> </tr>\n"
"  <tr><td>*</td> <td>1</td> <td>1</td>  <td>1</td> <td>DataIn</td> </tr>\n"
"  <tr><td>*</td> <td>0</td> <td>1</td>  <td>1</td> <td>NC</td> </tr>\n"
"</table>\n"
"\n"
"<blockquote><pre>\n"
"*  = do not care\n"
"~  = not equal\n"
"U  = L.'U'\n"
"0  = L.'0' or L.'L'\n"
"1  = L.'1' or L.'H'\n"
"X  = L.'X' or L.'W' or L.'Z' or L.'-'\n"

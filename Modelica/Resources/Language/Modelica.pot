msgid "Leakage reluctance with respect to the reluctance of a useful flux path (not for dynamic simulation of actuators)"
msgstr ""

msgctxt "Modelica.Magnetic.FluxTubes.Basic.LeakageWithCoefficient"
msgid "Ratio useful flux/(leakage flux + useful flux) = useful flux/total flux"

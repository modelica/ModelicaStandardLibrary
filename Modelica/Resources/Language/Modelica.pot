msgctxt "Modelica.Mechanics.Rotational.Components.IdealGear"
msgid "<html>\n"
"<p>\n"
"This element characterizes any type of gear box which is fixed in the\n"
"ground and which has one driving shaft and one driven shaft.\n"
"The gear is <strong>ideal</strong>, i.e., it does not have inertia, elasticity, damping\n"
"or backlash. If these effects have to be considered, the gear has to be\n"
"connected to other elements in an appropriate way.\n"
"</p>\n"
"\n"
"</html>"
msgstr ""

msgctxt "Modelica.Mechanics.Rotational.Components.IdealGear"
msgid "Angle between left shaft flange and support"
msgstr ""

msgctxt "Modelica.Mechanics.Rotational.Components.IdealGear"
msgid "Angle between right shaft flange and support"
msgstr ""

msgctxt "Modelica.Mechanics.Rotational.Components.IdealGear"
